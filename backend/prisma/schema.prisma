// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model EmergencyEvent {
  id                   String   @id @default(uuid())
  createdAt            DateTime @default(now())
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude             Float?
  longitude            Float?
  latitudeEncrypted    String?
  longitudeEncrypted   String?
  status               String   @default("ACTIVE")
  audioUrl             String?
  // Legacy single-video field. No longer written to by the video-segment
  // flow (camera-flip support splits video into ordered segments below) —
  // kept only so emergencies recorded before that shipped still display
  // their video in Evidence.
  videoUrl             String?
  videoSegments        EmergencyVideoSegment[]
  contactNotified      Boolean  @default(false)
  notificationError    String?
  notificationAttempts Int      @default(0)

  @@index([userId])
}

model EmergencyVideoSegment {
  id          String         @id @default(uuid())
  emergencyId String
  emergency   EmergencyEvent @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  fileUrl     String // encrypted storage key, same convention as EmergencyEvent.videoUrl
  facing      String // 'front' | 'back'
  sequence    Int
  // Client-reported capture metadata for display only — device clocks can
  // be wrong. Ordering is always by `sequence`, never by these.
  startedAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime       @default(now())

  @@unique([emergencyId, sequence])
  @@index([emergencyId])
}

model TrustedContact {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phoneNumber String
  // HMAC of the same normalized phone number as phoneNumber, computed
  // alongside it purely so a contact can be matched against a registered
  // User.phoneHash for covert-message delivery without decrypting rows.
  phoneHash   String?
  isPriority  Boolean  @default(false)

  @@index([userId])
  @@index([phoneHash])
}

model Recording {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl   String
  type      String

  @@index([userId])
}

model User {
  id                  String               @id @default(uuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  emailHash           String               @unique
  emailEncrypted      String
  nameEncrypted       String?
  passwordHash        String
  contacts            TrustedContact[]
  emergencies         EmergencyEvent[]
  recordings          Recording[]
  privateData         PrivateData[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  // Covert-messaging identity (Phase F). All optional — a user only gains
  // these once they opt in to the feature from ProfileScreen.
  // publicKey is NOT secret (the matching private key never leaves the
  // device) — encrypted at rest anyway for metadata-hygiene consistency
  // with this table's other PII, not because the key itself is sensitive.
  publicKey              String?
  phoneHash              String?         @unique
  phoneEncrypted         String?
  sentCovertMessages     CovertMessage[] @relation("SentCovertMessages")
  receivedCovertMessages CovertMessage[] @relation("ReceivedCovertMessages")

  // Bes Premium subscription state. RevenueCat (wrapping Google Play
  // Billing) is the actual billing system of record — these fields are a
  // cached, server-side mirror of RevenueCat's entitlement state, kept
  // fresh via the /api/billing/webhook handler, and exist only so our own
  // API can cheaply gate requests without calling RevenueCat synchronously
  // on every request. If this table and RevenueCat ever disagree (a missed
  // webhook, a support-initiated refund processed only in Play/RevenueCat,
  // etc.), RevenueCat is correct and this table is stale — the fix is
  // always "resync from RevenueCat," never "trust the DB over RevenueCat."
  subscriptionStatus    String    @default("free") // "free" | "active" | "billing_issue" | "cancelled" | "expired" — debugging/support only, never read by gating code
  subscriptionExpiresAt DateTime? // THE gate everywhere: entitled iff this is set and in the future
  subscriptionProductId String?
  lastRevenueCatEventAt DateTime? // guards against out-of-order webhook delivery

  ownedAccountLinks  AccountLink[] @relation("OwnedAccountLinks")
  linkedAccountLinks AccountLink[] @relation("LinkedAccountLinks")
}

// Bes Pro "Linked Accounts" — distinct from TrustedContact: both sides are
// real Bes users, and the linked side must explicitly consent (see
// accountLinkController.js's two-step preview/accept flow). A 'pending'
// row has linkedUserId: null (the invite code hasn't been redeemed yet,
// so the identity of the accepting user isn't known until it is);
// linkedUserId is set exactly once, atomically with status -> 'active'.
model AccountLink {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  ownerUserId String
  ownerUser   User   @relation("OwnedAccountLinks", fields: [ownerUserId], references: [id], onDelete: Cascade)

  linkedUserId String?
  linkedUser   User?   @relation("LinkedAccountLinks", fields: [linkedUserId], references: [id], onDelete: Cascade)

  relationshipType String // 'child' | 'family' | 'friend' — descriptive only, never authorization; permissions below are the sole source of truth for what's shared
  status           String @default("pending") // 'pending' | 'active' | 'revoked'

  // Default: { emergencyAlerts: true, liveLocationDuringEmergency: true, backgroundLocation: false }.
  // backgroundLocation is owner-readable but only linked-user-settable —
  // it depends on that user's own separate Background Location Monitoring
  // opt-in and their consent to share it with this specific owner.
  // No safetyPlan key yet (deferred) — adding one later is additive, not
  // a migration.
  permissions Json @default("{\"emergencyAlerts\": true, \"liveLocationDuringEmergency\": true, \"backgroundLocation\": false}")

  // Invite-code secret, same shape as PasswordResetToken. Unlike a
  // password-reset code (looked up scoped to an already-known userId),
  // this is looked up globally by codeHash alone, since the accepting
  // user's identity isn't known until they redeem it — hence a longer,
  // higher-entropy code than PasswordResetToken's 6 digits.
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)

  acceptedAt    DateTime?
  revokedAt     DateTime?
  revokedByRole String? // 'owner' | 'linked' — no third self-relation needed, the revoker is always one of the two users already on this row

  @@index([ownerUserId])
  @@index([linkedUserId])
  @@index([codeHash])
}

model CovertMessage {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  senderId        String
  sender          User     @relation("SentCovertMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientUserId String
  recipient       User     @relation("ReceivedCovertMessages", fields: [recipientUserId], references: [id], onDelete: Cascade)
  // Opaque steganographic PNG blob location (storageService key) — the
  // backend never touches ciphertext/plaintext/keys, only this file.
  fileUrl         String
  status          String   @default("SENT")
  protocolVersion Int      @default(1)

  @@index([recipientUserId])
  @@index([senderId])
}

model RefreshToken {
  id                  String    @id @default(uuid())
  createdAt           DateTime  @default(now())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  userAgent           String?

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String // hashLookup(code) — same HMAC helper RefreshToken.tokenHash uses
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0) // wrong-code guesses; caps brute force independent of per-IP rate limiting

  @@index([userId])
}

model PrivateData {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key           String
  dataEncrypted String

  @@unique([userId, key])
  @@index([userId])
}
